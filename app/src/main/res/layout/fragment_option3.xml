<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FDF7F2">

    <!-- Header with Logo and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="i-SURAT"
            android:textColor="#070000"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/pagbabantasLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:text="PAGBABANTAS"
            android:textColor="#070000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- Instruction Text -->
    <TextView
        android:id="@+id/instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:text="Panuto: Hanapin sa kahon at i-drag ang wastong bantas upang mabuo ang pangungusap."
        android:textColor="#070000"
        android:textSize="14sp" />

    <!-- Question Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/maroon_border"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/punctuation1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="!" />

        <TextView
            android:id="@+id/punctuation2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="." />

        <TextView
            android:id="@+id/punctuation3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="-" />

        <TextView
            android:id="@+id/punctuation4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="," />

        <TextView
            android:id="@+id/punctuation5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="@string/question_mark"  />

        <TextView
            android:id="@+id/punctuation6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/circle_border"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:textSize="40dp"
            android:text="&quot;" />
        
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Question 1 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q1word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:text="1. Sa"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q1word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="bakasyon"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingEnd="4dp" />

                <TextView
                    android:id="@+id/q1word3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:text="pupunta kami sa"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q1word4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baguio"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingEnd="4dp" />

                <TextView
                    android:id="@+id/q1word5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:text="Tagaytay,"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q1word6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:text="at Ilocos."
                    android:textColor="#000000"
                    android:textSize="16sp" />

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Question 2 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q2word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Ang paborito kong prutas ay "
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q2word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="saging"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingEnd="4dp" />

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Question 3 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q3word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Si Juan ay "
                    android:textColor="#070000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q3word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="araw"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingRight="2dp"
                    />

                <TextView
                    android:id="@+id/q3word3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="araw "
                    android:textColor="#FF0000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q3word4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pumapasok sa paaralan."
                    android:textColor="#100101"
                    android:textSize="16sp" />

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Question 4 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q4word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Sabi niya, "
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q4word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patawad, hindi na ito mauulit"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingEnd="4dp" />

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Question 5 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q5word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Napakasarap ng pagkaing "
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q5word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ito"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:paddingEnd="4dp" />

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Question 6 -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:alignItems="baseline"
                android:padding="8dp">

                <TextView
                    android:id="@+id/q6word1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Hindi ba siya "
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q6word2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="yun"
                    android:textColor="#FF0000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/q6word3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Yung lagi nya na kasama?"
                    android:textColor="#000000"
                    android:textSize="16sp" />

            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Continue Button -->
    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#00796B"
        android:text="Magpatuloy"
        android:textColor="#FFF"
        android:textSize="16sp" />

</LinearLayout>
